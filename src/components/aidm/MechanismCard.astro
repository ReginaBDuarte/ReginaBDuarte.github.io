---
import type { Mechanism } from '../../lib/aidm';
import { getFactor } from '../../lib/aidm';

interface Props {
  mechanism: Mechanism;
  hidden?: boolean;
}
const { mechanism, hidden = false } = Astro.props;
const factor = getFactor(mechanism.factor)!;
---
<article class="mechanism-card" id={`mechanism-${mechanism.id}`} tabindex="-1" hidden={hidden}>
  <h3>{mechanism.claim}</h3>
  <div class="meta-row">
    <span class="evidence-count">
      {mechanism.n_support} supporting{mechanism.n_contradict > 0 ? ` · ${mechanism.n_contradict} contradicting` : ''}
    </span>
    <span class="dot">·</span>
    <button type="button" class="factor-link" data-open-factor={factor.id}>{factor.factor}</button>
  </div>
  <div class="affects">
    {mechanism.affects.map((a) => <span class="chip">{a}</span>)}
  </div>
  <details class="details">
    <summary>Details</summary>
    <p>{mechanism.description}</p>
  </details>
</article>

<style>
  .mechanism-card {
    background: var(--paper);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: box-shadow var(--dur-slow) var(--ease-out), border-color var(--dur-slow) var(--ease-out);
  }
  .mechanism-card.jump-target {
    border-color: var(--coral-300);
    box-shadow: 0 0 0 3px var(--coral-100);
  }
  .mechanism-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink-900);
    margin: 0;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-faint);
  }
  .meta-row .dot { color: var(--border-strong); }
  .factor-link {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--coral-700);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .factor-link:hover { color: var(--coral-600); }
  .affects {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .chip {
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--steel-100);
    color: var(--steel-600);
  }
  .details {
    margin-top: 16px;
  }
  .details summary {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--coral-700);
    cursor: pointer;
  }
  .details p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-700);
    margin: 12px 0 0;
  }
</style>
