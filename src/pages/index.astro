---
import Layout from '../layouts/Layout.astro';
import ResearchRow from '../components/ResearchRow.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localizePath, defaultLang, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const allResearch = await getCollection('research');
const selected = allResearch
  .filter((entry) => entry.data.selected)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);
---
<Layout title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <img class="bloom" src="/motifs/agent-bloom.png" alt="" />
      <h1>{t.hero.headline}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="subline">{t.hero.subline}</p>
    </div>
  </section>

  <!-- Selected research -->
  <section id="research">
    <div class="wrap">
      <h2>{t.selectedResearch.heading}</h2>
      <div class="rows">
        {selected.map((entry) => <ResearchRow entry={entry} />)}
      </div>
      <a class="all-link" href={localizePath('/research/', lang)}>{t.selectedResearch.allLink}</a>
    </div>
  </section>

  <!-- Currently -->
  <section id="currently">
    <div class="wrap">
      <h2>{t.currently.heading}</h2>
      <dl class="currently-list">
        {t.currently.items.map((item) => (
          <div class="item">
            <dt>{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

</Layout>

<style>
  .hero {
    position: relative;
    padding: 96px 0 80px;
    overflow: hidden;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display-l);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
    margin: 0;
    max-width: 880px;
  }
  .hero .lead {
    font-size: var(--text-body-l);
    line-height: 1.55;
    color: var(--ink-600);
    max-width: 600px;
    margin: 28px 0 0;
  }
  .hero .subline {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text-faint);
    margin: 20px 0 0;
  }
  .bloom {
    position: absolute;
    top: 40px;
    right: 0;
    width: 180px;
    opacity: 0.95;
  }

  #research h2,
  #currently h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-headline);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
    margin: 0 0 32px;
  }
  .rows { margin-bottom: 20px; }
  .all-link {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--coral-700);
    text-decoration: none;
  }
  .all-link:hover { text-decoration: underline; }

  .currently-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .currently-list .item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
  }
  .currently-list dt {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--coral-700);
  }
  .currently-list dd {
    margin: 0;
    font-size: var(--text-body-l);
    line-height: var(--leading-normal);
    color: var(--ink-800);
  }

  @media (max-width: 720px) {
    .hero { padding: 56px 0 40px; }
    .bloom { display: none; }
    .currently-list .item { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
